<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 10-14 需要的权限 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" /> <!-- Android 13+ 需要的媒体权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" /> <!-- Android 14+ 新增的部分媒体访问 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" /> <!-- 如果需要所有文件访问权限（谨慎使用） -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" /> <!-- 声明要访问的文件类型（可选但推荐） -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Cling DLNA SSDP 发现需要组播权限与 WiFi 状态 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Cling AndroidRouter 创建 WifiLock 需要 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 接收端 DLNA 服务以前台服务运行，避免退出 Activity 后进程被回收导致设备消失 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".app.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logo"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reading"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.wheel.activity.BatchAddActivity"
            android:exported="false" />
        <activity
            android:name=".ui.wheel.activity.WheelTemplateActivity"
            android:exported="false" />
        <activity
            android:name=".ui.wheel.activity.WheelListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.wheel.activity.OptionListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.read.activity.PdfReaderActivity"
            android:exported="false" />
        <activity
            android:name=".ui.read.activity.EpubReaderActivity"
            android:exported="false" />
        <activity
            android:name=".ui.read.activity.FolderPickerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.read.activity.ReaderActivity"
            android:exported="false" />
        <activity
            android:name=".ui.read.activity.VideoPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensor" />
        <activity
            android:name=".ui.main.activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider：用于将视频文件以 content:// URI 共享给第三方播放器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Cling DLNA/UPnP 服务：负责 SSDP 设备发现与控制。
             接收端开启时以前台服务运行，保证退出 Activity 后仍可被发现。 -->
        <service
            android:name="com.wrz.reading.dlna.CustomAndroidUpnpServiceImpl"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="DLNA MediaRenderer,接收投屏" />
        </service>
    </application>

</manifest>