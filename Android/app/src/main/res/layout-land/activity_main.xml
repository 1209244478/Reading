<?xml version="1.0" encoding="utf-8"?>
<!--
  手机（非平板）横屏布局：悬浮液态玻璃导航栏从底部改为屏幕右侧。
  使用 NavigationRailView（与 BottomNavigationView 同为 NavigationBarView 子类，
  复用同一 menu，MainActivity 中 NavigationUI.setupWithNavController 直接兼容）。
  平板横屏由 layout-sw600dp-land 覆盖，仍保持底部导航。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/ios_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Navigation Host Fragment：右侧约束到悬浮导航容器，内容区让出右栏 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bottom_nav_container"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 悬浮液态玻璃导航容器：垂直居中悬浮于屏幕右侧，圆角玻璃背景 + 柔和阴影。
         rightMargin 由 MainActivity 在 inset 回调中设置（基础 8dp + 系统 right inset） -->
    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_liquid_glass_nav"
        android:layout_marginEnd="8dp"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:backgroundTint="@android:color/transparent"
            app:elevation="0dp"
            app:labelVisibilityMode="labeled"
            app:itemRippleColor="@android:color/transparent"
            app:itemIconTint="@color/bottom_nav_item_selector"
            app:itemTextColor="@color/bottom_nav_item_selector"
            app:menu="@menu/bottom_nav_menu" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
