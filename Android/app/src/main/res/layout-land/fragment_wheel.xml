<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    android:background="@color/ios_background"
    android:fitsSystemWindows="true"
    app:cardBackgroundColor="@color/ios_card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ios_border"
    app:strokeWidth="1dp"
    tools:context=".ui.wheel.fragment.WheelFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/ll_msg"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 标题 -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/title_wheel"
                android:textColor="@color/ios_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 结果显示区域 -->
            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@color/ios_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 提示文本 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/hint_tips"
                android:textColor="@color/ios_text_secondary"
                android:textSize="12sp"
                android:visibility="visible" />


        </LinearLayout>


        <!-- 转盘容器 -->
        <FrameLayout
            android:id="@+id/wheelContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_toEndOf="@+id/ll_msg">

            <com.wrz.reading.ui.wheel.view.wheelview.WheelView
                android:id="@+id/wheel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/pointer"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:elevation="4dp"
                android:src="@drawable/ic_pointer" />

        </FrameLayout>

        <!-- 顶部菜单按钮：声明在 NestedScrollView 之后，确保 z 轴在上层可点击 -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/my_wheel"
            android:src="@drawable/menu_24px"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/ios_text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startBtn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="@string/start_spinning"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ios_blue"
            app:cornerRadius="14dp"
            app:rippleColor="#22FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editBtn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:text="@string/edit_wheel"
            android:textColor="@color/ios_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/ios_border"
            app:strokeWidth="1dp" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
