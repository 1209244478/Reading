<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    android:background="@color/ios_background"
    android:fitsSystemWindows="true"
    android:orientation="horizontal"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ios_border"
    app:strokeWidth="1dp"
    tools:context=".ui.random.fragment.RandomFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- 顶部栏：范围胶囊 + 设置入口 -->
        <LinearLayout
            android:id="@+id/ll_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 范围胶囊：start ~ end -->
            <TextView
                android:id="@+id/tv_start"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_range_chip"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="56dp"
                android:textColor="@color/ios_text_primary"
                android:textSize="15sp"
                tools:text="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="—"
                android:textColor="@color/ios_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_end"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_range_chip"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="56dp"
                android:textColor="@color/ios_text_primary"
                android:textSize="15sp"
                tools:text="100" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btn_generate"
            android:layout_below="@+id/ll_top"
            android:layout_marginVertical="8dp"
            android:background="@drawable/bg_random_rv"
            android:clipToPadding="false"
            android:padding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="@string/generate_random_number"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ios_blue"
            app:cornerRadius="14dp"
            app:rippleColor="#22FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:text="@string/clear"
            android:textColor="@color/ios_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/ios_border"
            app:strokeWidth="1dp" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/setting"
            android:src="@drawable/menu_24px"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/ios_text_primary" />

    </RelativeLayout>


</com.google.android.material.card.MaterialCardView>
