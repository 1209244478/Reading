<?xml version="1.0" encoding="utf-8"?><!--
  平板横屏布局：与默认布局一致，保持底部悬浮导航。
  仅用于覆盖 layout-land（资源解析优先级 sw600dp-land > land），
  使"横屏显示右侧导航栏"只对手机（最小宽度 < 600dp）生效。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Navigation Host Fragment：底部约束到悬浮导航容器顶部，留出玻璃栏的悬浮空间 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_graph" />

    <!-- 悬浮液态玻璃导航容器：左右与底部留白，圆角玻璃背景 + 柔和阴影 -->
    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_liquid_glass_nav"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.wrz.reading.ui.main.view.BottomNavBar
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mainFragment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="center"
                android:src="@drawable/ic_home"
                app:tint="@color/bottom_nav_default" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/wheelFragment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="center"
                android:src="@drawable/ic_wheel"
                app:tint="@color/bottom_nav_default" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/randomFragment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="center"
                android:src="@drawable/ic_random"
                app:tint="@color/bottom_nav_default" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/settingFragment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="center"
                android:src="@drawable/ic_setting"
                app:tint="@color/bottom_nav_default" />

        </com.wrz.reading.ui.main.view.BottomNavBar>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
