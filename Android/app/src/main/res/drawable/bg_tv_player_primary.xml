<?xml version="1.0" encoding="utf-8"?>
<!-- 主播放键：常态亮黄，焦点热粉，按压青 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_ink" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_pink" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/tv_ink" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_cyan" />
            <stroke
                android:width="3dp"
                android:color="@color/tv_ink" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_ink" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_yellow" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/tv_ink" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
