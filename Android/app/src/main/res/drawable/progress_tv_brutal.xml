<?xml version="1.0" encoding="utf-8"?>
<!-- 新粗野主义进度条：米白描边黑槽 + 亮黄进度块 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_alt" />
            <stroke
                android:width="2dp"
                android:color="@color/tv_paper" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/tv_pink" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/tv_yellow" />
                <stroke
                    android:width="2dp"
                    android:color="@color/tv_ink" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
