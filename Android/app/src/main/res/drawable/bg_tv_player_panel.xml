<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器底部控制台：近黑半透明面板 + 米白粗边 + 顶部黄色色条 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F20A0A0D" />
            <stroke
                android:width="2dp"
                android:color="@color/tv_paper" />
        </shape>
    </item>
    <item
        android:height="4dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_yellow" />
        </shape>
    </item>
</layer-list>
