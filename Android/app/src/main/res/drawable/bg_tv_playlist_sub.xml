<?xml version="1.0" encoding="utf-8"?>
<!-- 播放列表子项：左侧黄色条块 + 焦点反白 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_alt" />
            <stroke
                android:width="3dp"
                android:color="@color/tv_yellow" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_alt" />
            <stroke
                android:width="3dp"
                android:color="@color/tv_orange" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/tv_surface_alt" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
