<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#F0F0F0"
    style="@style/Widget.MaterialComponents.CardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <LinearLayout
            android:id="@+id/ll_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <!-- 文件图标 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/file_icon_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/file_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_folder"
                    android:background="@drawable/bg_folder_item"
                    android:scaleType="center"
                    android:padding="8dp"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- 文件信息 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">

                <TextView
                    android:id="@+id/tv_folder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="文件名"
                    android:textSize="16sp"
                    android:textColor="#F6F1F1"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_file_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="详情信息"
                    android:textSize="13sp"
                    android:textColor="#E6DCDC"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_exist"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#FF5722"
                android:textSize="14sp"
                android:gravity="center"
                android:visibility="gone"
                android:text="已添加"/>

            <!-- 选择指示器 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/select_indicator"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="#DBD6D6"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/checkIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    android:padding="4dp"/>


            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
