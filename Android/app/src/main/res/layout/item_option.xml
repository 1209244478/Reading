<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ios_card_background"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_delete"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:contentDescription="@string/delete"
            android:src="@drawable/reduce_circle"
            app:tint="@color/ios_text_secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:boxStrokeWidth="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ios_card_background"
                android:paddingBottom="14dp"
                android:text="@string/dialog_title"
                android:textColor="@color/ios_text_primary"
                android:textSize="18sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/color_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/color_card_margin"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/color_card_radius"
            app:cardElevation="0dp"
            tools:cardBackgroundColor="#FFFF" />

        <TextView
            android:id="@+id/tv_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_folder_item"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="@color/ios_text_secondary"
            android:textSize="14sp"
            tools:text="1|10%" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:visibility="gone"
            app:tint="@color/ios_text_secondary" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/ios_border" />


</LinearLayout>
