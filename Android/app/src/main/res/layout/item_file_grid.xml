<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MaterialComponents.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:foreground="@drawable/bg_tv_focusable"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/ll_item"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical">

            <!-- 文件图标 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/file_icon_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/file_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_folder_item"
                    android:padding="8dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_folder" />

            </com.google.android.material.card.MaterialCardView>

            <!-- 文件信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_folder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/file_name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/tv_file_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="详情信息"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="50dp"
            android:layout_height="35dp"
            android:layout_gravity="end"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_exist"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="已添加"
                android:textColor="#FF5722"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- 选择指示器 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/select_indicator"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:focusable="false"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#BDBDBD"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/checkIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />


            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
