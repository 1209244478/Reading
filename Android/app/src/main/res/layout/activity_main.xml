<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Navigation Host Fragment：底部约束到悬浮导航容器顶部，留出玻璃栏的悬浮空间 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav_container" />

    <!-- 悬浮液态玻璃导航容器：左右与底部留白，圆角玻璃背景 + 柔和阴影 -->
    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="0dp"
        android:layout_height="79dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_liquid_glass_nav"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:backgroundTint="@android:color/transparent"
            android:paddingTop="10dp"
            app:elevation="0dp"
            app:labelVisibilityMode="labeled"
            app:itemRippleColor="@android:color/transparent"
            app:itemIconTint="@color/bottom_nav_item_selector"
            app:itemTextColor="@color/bottom_nav_item_selector"
            app:menu="@menu/bottom_nav_menu" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
