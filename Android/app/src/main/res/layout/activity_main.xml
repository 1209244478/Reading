<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Navigation Host Fragment：底部约束到悬浮导航容器顶部，留出玻璃栏的悬浮空间 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_graph" />

    <!-- 悬浮液态玻璃导航容器：左右与底部留白，圆角玻璃背景 + 柔和阴影。
         高度固定 62dp，item 图标通过 scaleType=center + match_parent 恒定垂直居中 -->
    <LinearLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_nav_height"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_liquid_glass_nav">

        <com.wrz.reading.ui.main.view.BottomNavBar
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mainFragment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="center"
                android:src="@drawable/ic_home"
                app:tint="@color/bottom_nav_default" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/wheelFragment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="center"
                android:src="@drawable/ic_wheel"
                app:tint="@color/bottom_nav_default" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/randomFragment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="center"
                android:src="@drawable/ic_random"
                app:tint="@color/bottom_nav_default" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/settingFragment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="center"
                android:src="@drawable/ic_setting"
                app:tint="@color/bottom_nav_default" />

        </com.wrz.reading.ui.main.view.BottomNavBar>

    </LinearLayout>

</RelativeLayout>
