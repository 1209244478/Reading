<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="visible"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <LinearLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal">

        <!-- 标题：文件名 -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:visibility="visible"
            tools:text="@string/about_us" />


        <!-- 下载按钮：仅接收投屏模式下显示（把发送端视频下载到本地） -->
        <ImageButton
            android:id="@+id/download_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_download"
            android:focusable="true"
            android:src="@drawable/ic_download"
            android:visibility="gone"
            app:tint="@android:color/white" />

        <!-- 音轨按钮：多音轨视频可选音轨（本地/接收模式切换播放器音轨；投屏模式重封装后重投） -->
        <ImageButton
            android:id="@+id/audio_track_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_audio_track"
            android:focusable="true"
            android:src="@drawable/ic_audio_track"
            android:visibility="gone"
            app:tint="@android:color/white" />

        <!-- 投屏按钮：点击弹出 DLNA 设备列表（投屏到智能电视） -->
        <ImageButton
            android:id="@+id/cast_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="投屏"
            android:focusable="true"
            android:src="@drawable/ic_cast"
            app:tint="@android:color/white" />

        <!-- 列表按钮：点击弹出 播放视频列表 -->
        <ImageButton
            android:id="@+id/play_list"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="播放列表"
            android:focusable="true"
            android:src="@drawable/menu_24px"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- 锁定按钮：右侧中部；锁定时仅保留此按钮用于解锁 -->
    <ImageButton
        android:id="@+id/lock_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_lock_screen"
        android:focusable="true"
        android:src="@drawable/ic_lock_open"
        android:visibility="gone"
        app:tint="@android:color/white" />


    <!-- 手势提示：双击/滑动时居中短暂显示位置/亮度/音量变化 -->
    <TextView
        android:id="@+id/gesture_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#80000000"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- 投屏控制浮层：投屏成功后覆盖整个屏幕，统一控制电视端 -->
    <FrameLayout
        android:id="@+id/cast_control_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- 顶部：投屏状态 + 设备名 + 关闭 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="投屏中"
                android:src="@drawable/ic_cast"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/cast_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="投屏中"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_keep_black"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="黑屏观看"
                android:textColor="@android:color/white"
                android:textSize="14sp" />


            <TextView
                android:id="@+id/tv_keep_watch"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="本机继续看"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <!-- 音轨按钮：多音轨视频投屏时重封装并重投（仅多音轨时显示） -->
            <TextView
                android:id="@+id/cast_audio_track"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:text="@string/btn_audio_track"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/cast_stop"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="停止投屏"
                android:src="@drawable/ic_close"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- 中央：大号播放/暂停按钮 -->
        <ImageButton
            android:id="@+id/cast_play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="暂停/播放"
            android:src="@android:drawable/ic_media_pause"
            app:tint="@android:color/white" />

        <!-- 底部：标题 + 进度条 + 时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/cast_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/cast_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progressTint="@android:color/white"
                android:secondaryProgressTint="#80FFFFFF"
                android:thumbTint="@android:color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cast_current_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/cast_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>


    <View
        android:id="@+id/view_blank"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />

</FrameLayout>
