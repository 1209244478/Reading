<?xml version="1.0" encoding="utf-8"?>
<!-- 电视端批量重命名弹窗：固定高度，列表可滚动 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="760dp"
    android:layout_height="420dp"
    android:background="@drawable/bg_tv_dialog"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_folder"
            android:tint="@color/tv_yellow" />

        <TextView
            android:id="@+id/dialog_title"
            style="@style/TvDisplayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重命名"
            android:textSize="26sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/dialog_subtitle"
        style="@style/TvSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="输入新的名称" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/collection_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            style="@style/TvActionChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="取消" />

        <TextView
            android:id="@+id/btn_confirm"
            style="@style/TvActionChip"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="保存" />

    </LinearLayout>

</LinearLayout>
