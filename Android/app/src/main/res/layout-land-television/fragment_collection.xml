<?xml version="1.0" encoding="utf-8"?>
<!--
    电视端书库首页（新粗野主义）：
    超大标题 + 块状操作区 + 硬阴影卡片网格；所有操作均由遥控器焦点驱动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_page"
    android:orientation="vertical"
    tools:context=".ui.main.activity.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/tv_page_padding_horizontal"
        android:paddingTop="@dimen/tv_page_padding_vertical"
        android:paddingEnd="@dimen/tv_page_padding_horizontal"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TvDisplayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_library_title" />

            <TextView
                style="@style/TvKickerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tv_library_kicker" />

        </LinearLayout>

        <TextView
            android:id="@+id/btn_splash"
            style="@style/TvActionChip"
            android:layout_marginEnd="12dp"
            android:nextFocusDown="@id/collection_recycler_view"
            android:text="@string/tv_action_refresh" />

        <TextView
            android:id="@+id/btn_edit_name"
            style="@style/TvActionChip"
            android:layout_marginEnd="12dp"
            android:nextFocusDown="@id/collection_recycler_view"
            android:text="@string/tv_action_rename"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_select_mode"
            style="@style/TvActionChip"
            android:layout_marginEnd="12dp"
            android:nextFocusDown="@id/collection_recycler_view"
            android:text="@string/tv_action_select" />

        <LinearLayout
            android:id="@+id/add_comic_fab"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_action_height"
            android:background="@drawable/bg_tv_cta"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:nextFocusDown="@id/collection_recycler_view"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="26dp"
            android:stateListAnimator="@animator/tv_focus_lift">

            <ImageView
                android:id="@+id/add_comic_fab_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/add_24px"
                app:tint="@color/tv_ink" />

            <TextView
                android:id="@+id/add_comic_fab_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/tv_action_new_collection"
                android:textColor="@color/tv_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/btn_setting"
            style="@style/TvActionChip"
            android:nextFocusDown="@id/collection_recycler_view"
            android:text="@string/setting" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:background="@color/tv_yellow" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/collection_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:overScrollMode="never"
            android:paddingStart="@dimen/tv_page_padding_horizontal"
            android:paddingTop="18dp"
            android:paddingEnd="@dimen/tv_page_padding_horizontal"
            android:paddingBottom="20dp"
            android:scrollbars="none"
            tools:listitem="@layout/item_collection" />

        <LinearLayout
            android:id="@+id/empty_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_tv_empty"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="44dp"
            android:paddingEnd="56dp"
            android:paddingBottom="48dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_tv_icon_box">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/tv_ink" />

            </FrameLayout>

            <TextView
                style="@style/TvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/tv_empty_library_title" />

            <TextView
                style="@style/TvEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/tv_empty_library_hint" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
