<?xml version="1.0" encoding="utf-8"?>
<!-- 电视端批量重命名输入行：容器接收遥控器焦点，OK 后唤起输入法 -->
<com.google.android.material.textfield.TextInputLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collection_name_layout"
    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:hint="名称"
    app:boxBackgroundColor="@color/tv_surface"
    app:boxCornerRadiusBottomEnd="8dp"
    app:boxCornerRadiusBottomStart="8dp"
    app:boxCornerRadiusTopEnd="8dp"
    app:boxCornerRadiusTopStart="8dp"
    app:boxStrokeColor="@color/tv_yellow"
    app:boxStrokeWidth="2dp"
    app:boxStrokeWidthFocused="3dp">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_collection_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/tv_paper"
        android:textColorHint="@color/tv_muted"
        android:textSize="17sp" />

</com.google.android.material.textfield.TextInputLayout>
