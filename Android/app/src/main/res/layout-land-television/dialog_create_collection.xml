<?xml version="1.0" encoding="utf-8"?>
<!-- 电视端新建/重命名集合输入弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="680dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tv_dialog"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_folder"
            android:tint="@color/tv_yellow" />

        <TextView
            android:id="@+id/dialog_title"
            style="@style/TvDisplayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="创建集合"
            android:textSize="26sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/dialog_subtitle"
        style="@style/TvSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="为你的漫画创建一个新集合" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/collection_name_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="名称"
        app:boxBackgroundColor="@color/tv_surface"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp"
        app:boxStrokeColor="@color/tv_yellow"
        app:boxStrokeWidth="2dp"
        app:boxStrokeWidthFocused="3dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_collection_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textColor="@color/tv_paper"
            android:textColorHint="@color/tv_muted"
            android:textSize="18sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            style="@style/TvActionChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="取消" />

        <TextView
            android:id="@+id/btn_confirm"
            style="@style/TvActionChip"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="创建" />

    </LinearLayout>

</LinearLayout>
