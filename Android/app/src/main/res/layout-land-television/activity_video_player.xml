<?xml version="1.0" encoding="utf-8"?>
<!--
    电视端视频播放器（新粗野主义 · 悬浮控制台版）：
    画面保持原始比例居中；标题卡与底部控制台悬浮在画面上，减少对内容的遮挡。
    收起控制台时：OK 播放/暂停，← → 快退/快进，↑ ↓ 呼出控制台。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="true"
        android:keepScreenOn="true"
        android:visibility="visible"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!-- 上下渐隐遮罩：让悬浮控制台与视频画面自然过渡 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_gravity="top"
        android:visibility="gone"
        android:background="@drawable/bg_tv_player_top_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="bottom"
        android:visibility="gone"
        android:background="@drawable/bg_tv_player_bottom_scrim" />

    <FrameLayout
        android:id="@+id/tv_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_tv_player_title"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="15dp"
            android:paddingEnd="28dp"
            android:paddingBottom="17dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.22"
                android:text="NOW PLAYING"
                android:textColor="@color/tv_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:maxWidth="560dp"
                android:textColor="@color/tv_paper"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="视频标题" />

        </LinearLayout>

    </FrameLayout>

    <ImageView
        android:id="@+id/tv_play_state"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_tv_play"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tv_control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_tv_player_deck"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/tv_player_hint"
            android:textColor="@color/tv_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_current_time"
                style="@style/TvPlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="82dp"
                android:text="0:00"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/tv_seekbar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_seek_focus"
                android:focusable="true"
                android:max="1000"
                android:nextFocusDown="@id/tv_btn_play_pause"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:progressDrawable="@drawable/progress_tv_brutal"
                android:splitTrack="false"
                android:thumb="@drawable/tv_seek_thumb" />

            <TextView
                android:id="@+id/tv_duration"
                style="@style/TvPlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="82dp"
                android:text="0:00"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tv_btn_play_pause"
                style="@style/TvPlayerButtonPrimary"
                android:nextFocusUp="@id/tv_seekbar">

                <ImageView
                    android:id="@+id/tv_play_pause_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tv_pause"
                    android:tint="@color/tv_ink" />

                <TextView
                    android:id="@+id/tv_play_pause_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="@string/tv_action_pause"
                    android:textColor="@color/tv_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_btn_rewind"
                style="@style/TvPlayerButtonSecondary"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/tv_action_rewind"
                android:nextFocusUp="@id/tv_seekbar">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tv_rewind"
                    android:tint="@color/tv_player_chip_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="快退"
                    android:textColor="@color/tv_player_chip_text"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_btn_forward"
                style="@style/TvPlayerButtonSecondary"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/tv_action_forward"
                android:nextFocusUp="@id/tv_seekbar">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tv_forward"
                    android:tint="@color/tv_player_chip_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="快进"
                    android:textColor="@color/tv_player_chip_text"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/play_list"
                style="@style/TvPlayerButtonSecondary"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/tv_action_playlist"
                android:nextFocusUp="@id/tv_seekbar">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:contentDescription="@null"
                    android:src="@drawable/menu_24px"
                    android:tint="@color/tv_player_chip_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="列表"
                    android:textColor="@color/tv_player_chip_text"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/audio_track_button"
                style="@style/TvPlayerButtonSecondary"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_audio_track"
                android:nextFocusUp="@id/tv_seekbar"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_audio_track"
                    android:tint="@color/tv_player_chip_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="音轨"
                    android:textColor="@color/tv_player_chip_text"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cast_button"
                style="@style/TvPlayerButtonSecondary"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/tv_action_cast"
                android:nextFocusUp="@id/tv_seekbar">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cast"
                    android:tint="@color/tv_player_chip_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="投屏"
                    android:textColor="@color/tv_player_chip_text"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/download_button"
                style="@style/TvPlayerButtonSecondary"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_download"
                android:nextFocusUp="@id/tv_seekbar"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_download"
                    android:tint="@color/tv_player_chip_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="下载"
                    android:textColor="@color/tv_player_chip_text"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_btn_back"
                style="@style/TvPlayerButtonSecondary"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/tv_action_back_player"
                android:nextFocusUp="@id/tv_seekbar">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_back"
                    android:tint="@color/tv_player_chip_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="返回"
                    android:textColor="@color/tv_player_chip_text"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/gesture_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC0A0A0D"
        android:fontFamily="sans-serif-condensed"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp"
        android:textColor="@color/tv_yellow"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 投屏控制浮层 -->
    <FrameLayout
        android:id="@+id/cast_control_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_cast_panel"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/tv_action_cast"
                android:src="@drawable/ic_cast"
                android:tint="@color/tv_yellow" />

            <TextView
                android:id="@+id/cast_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="@string/tv_action_cast"
                android:textColor="@color/tv_paper"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_keep_black"
                style="@style/TvPlayerChip"
                android:layout_marginStart="8dp"
                android:text="黑屏观看" />

            <TextView
                android:id="@+id/tv_keep_watch"
                style="@style/TvPlayerChip"
                android:layout_marginStart="8dp"
                android:text="本机继续看" />

            <TextView
                android:id="@+id/cast_audio_track"
                style="@style/TvPlayerChip"
                android:layout_marginStart="8dp"
                android:text="@string/btn_audio_track"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/cast_stop"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tv_player_secondary"
                android:contentDescription="停止投屏"
                android:focusable="true"
                android:padding="15dp"
                android:src="@drawable/ic_close"
                android:tint="@color/tv_player_chip_text" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/cast_play_pause"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_tv_player_primary"
            android:contentDescription="暂停/播放"
            android:focusable="true"
            android:padding="30dp"
            android:src="@android:drawable/ic_media_pause"
            android:tint="@color/tv_ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/cast_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:textColor="@color/tv_paper"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cast_current_time"
                    style="@style/TvPlayerTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="82dp"
                    android:text="0:00"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/cast_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tv_seek_focus"
                    android:focusable="true"
                    android:max="1000"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:progressDrawable="@drawable/progress_tv_brutal"
                    android:splitTrack="false"
                    android:thumb="@drawable/tv_seek_thumb" />

                <TextView
                    android:id="@+id/cast_duration"
                    style="@style/TvPlayerTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="82dp"
                    android:text="0:00"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <View
        android:id="@+id/view_blank"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />

</FrameLayout>
